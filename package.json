{
  "name": "resale-iq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:unit": "node --test \"src/lib/*.test.ts\"",
    "check:isolation": "node scripts/check-agent-isolation.mjs",
    "check:isolation:built": "node scripts/check-agent-isolation.mjs --built",
    "check:tracked": "node scripts/check-tracked-figure.mjs",
    "check:dupes": "node scripts/check-duplicate-logic.mjs",
    "check:silent": "node scripts/check-silent-failure.mjs",
    "check:locale-english": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-locale-english.mjs",
    "check:gates": "node scripts/check-stale-gates.mjs",
    "check:inventory": "node scripts/build-inventory.mjs --check",
    "check:tracked:built": "node scripts/check-tracked-figure.mjs --built",
    "check:warehouse": "node scripts/check-warehouse.mjs",
    "check:market-proof": "node scripts/check-market-proof-grain.mjs",
    "check:extension": "node scripts/check-extension.mjs",
    "seo:indexnow": "node scripts/indexnow.mjs",
    "test:e2e": "playwright test",
    "test:e2e:prod": "playwright test e2e/prod.smoke.spec.ts",
    "test:e2e:required": "playwright test e2e/smoke.spec.ts e2e/customer-workflow.spec.ts e2e/signup-verify.spec.ts e2e/regression-p0.spec.ts e2e/market-coverage.spec.ts e2e/locale-routing.spec.ts e2e/public-result-face.spec.ts e2e/deal-scanner-numbers.spec.ts e2e/momentum-vocabulary.spec.ts e2e/attribution-instrument.spec.ts --workers=2"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "next": "^16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
