# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# playwright
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# unattended agent loop runtime
agent/loop.log
agent/RATE_LIMITED

# per-session output the loop inspects
agent/.session.out

# Company OS: local telemetry, regenerated constantly; the dashboard reads it in place
docs/audit/ACTIVITY.jsonl
.claude/LOCK
.claude/UNLOCK_HARNESS
.claude/STOP_GATE_ON
.claude/DEPLOY_APPROVED

# Machine state, rewritten every hour by dev.resaleiq.os-verify. Tracking it would
# leave the tree permanently dirty and the Stop gate permanently blocked. STATUS.md
# stays tracked - it is the human-readable record - and is only written when it changes.
dashboard/status.json
dashboard/.status.prev.json

# Python bytecode from scripts/company/*.py
__pycache__/
*.pyc

# Agent worktrees. An agent created scratchpad/seo-i18n-routing as a nested git
# repo on 2026-09-01 and a git add -A swept it into a commit that was pushed.
# Scratch work belongs in the session scratchpad outside the repo; this is the
# backstop for when it does not.
scratchpad/

# Video capture intermediates. 134 PNGs per run, regenerated in seconds by
# scripts/capture_demo.mjs. The mp4 and the text cards are committed; the raw
# frames are not -- they are build output, not an asset.
docs/marketing/assets/frames/

# Intermediate render artifacts. The finished MP4 is the deliverable; the frame
# dumps and the pre-mux silent cuts are scratch, and committing them buries the
# real assets in a directory listing.
docs/marketing/assets/frames*/
docs/marketing/assets/*-silent.mp4

# Pre-mux silent cuts under renders/ are intermediates too.
docs/marketing/assets/renders/*-silent.mp4

# A production DB copy must never ship to visitors — this repo is served.
data/prod.db
data/*.db
