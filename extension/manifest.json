{
  "manifest_version": 3,
  "name": "Resale IQ — Reseller price check",
  "version": "1.4.0",
  "description": "For resellers: what it resells for on Vinted and the max price to pay when sourcing stock.",
  "homepage_url": "https://resaleiq.dev",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Resale IQ",
    "default_popup": "options.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://resaleiq.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.es/*",
        "https://www.vinted.fr/*",
        "https://www.vinted.de/*",
        "https://www.vinted.it/*",
        "https://www.vinted.pt/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://resaleiq.dev/*"
      ],
      "js": [
        "link.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
